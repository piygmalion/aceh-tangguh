# Supabase (Aceh Tangguh) - copy to .env.local and fill values.
# Vercel production/preview reads NEXT_PUBLIC_* from .env.production.
# Copy this file to .env.local for local admin / laporan writes, then add
# SUPABASE_SERVICE_ROLE_KEY (never commit). If public keys are unset, APIs
# fall back to fixtures / empty / hardcoded defaults.
# Used by: /api/stats/live, /api/hazards, /api/reports (POST requires it),
# /api/irbi (optional area_feature_meta merge), /api/layers/catalog,
# /api/layers/meta/[layerKey]
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional for admin UI only. Required on the Node server for laporan writes,
# media upload, WA queue, and weather cache refresh. Never expose to the browser
# and never set it on the GitHub Pages job.
# SUPABASE_SERVICE_ROLE_KEY=

# Laporan masyarakat (kejadian + penanganan) — server/cron only
# Production refuses submits without PII key + custom salt + service role.
# LAPORAN_PII_KEY=          # 64 hex chars — AES-256-GCM for pelapor PII (generate: node scripts/generate-laporan-pii-key.mjs)
# LAPORAN_PII_SALT=         # custom salt for SHA-256 hashes (NIK/phone lookup); do not use aceh-tangguh-dev
# LAPORAN_CRON_SECRET=      # Bearer for POST /api/cron/laporan-wa
# LAPORAN_CRON_URL=         # optional base URL for scripts/process-laporan-wa.mjs (default http://localhost:3000)
# WHATSAPP_GATEWAY_URL=     # HTTP endpoint for outbound WhatsApp
# WHATSAPP_GATEWAY_TOKEN=    # optional Bearer for gateway

# Weather cron (POST /api/weather/refresh) — server-only, never expose
# WEATHER_CRON_SECRET=
# GitHub Actions: set secret WEATHER_CRON_SECRET + variable WEATHER_REFRESH_URL
# (e.g. https://your-domain/api/weather/refresh)

# Distributed rate limit (required in production for public POST routes)
# Free tier: https://upstash.com — create a Redis database, copy REST URL + token.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Data routing
# Domain datasets prefer Supabase (anon SELECT) and fall back to
# public/fixtures/*.json when env is missing, a query errors, or the
# table/document is empty:
#   kejadian_bencana, marker_features, anggaran_analisis,
#   anggaran_kegiatan, publikasi_meta, publikasi, publikasi_kegiatan, r3p_summary,
#   irbi_documents, data_documents (optional JSON snapshots)
# Apply supabase/migrations/20260906_cms_domain_tables.sql on new environments.
#
# Geometry stays in fixtures + PMTiles — do not store polygon GeoJSON
# or PMTiles in Postgres:
#   public/fixtures/areas/*.geojson
#   public/fixtures/boundaries-aceh-kab.geojson
#   public/tiles/*.pmtiles
#   GET /api/layers/areas/[key], GET /api/boundaries

# GitHub Pages static preview (optional — fixtures work without these)
# Local: STATIC_EXPORT=1 bun run build   → writes out/
# Actions: set repository variable NEXT_PUBLIC_SUPABASE_URL and
# secret NEXT_PUBLIC_SUPABASE_ANON_KEY if you want the browser to
# have anon credentials. The static preview still reads public/fixtures
# for homepage + map; admin / laporan POST / API routes are omitted.
# STATIC_EXPORT=1
# GITHUB_PAGES=1
# NEXT_PUBLIC_BASE_PATH=/aceh-tangguh
