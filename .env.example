# Supabase (Aceh Tangguh) - copy to .env.local and fill values.
# Vercel production/preview reads NEXT_PUBLIC_* from .env.production.
# Copy this file to .env.local for local admin / laporan writes, then add
# SUPABASE_SERVICE_ROLE_KEY (never commit). If public keys are unset, APIs
# fall back to fixtures / empty / hardcoded defaults.
# Used by: /api/stats/live, /api/irbi (optional area_feature_meta merge),
# /api/layers/catalog, /api/layers/meta/[layerKey].
# GET /api/hazards is retired (503). GET|POST /api/reports is 410 Gone.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional for admin UI only. Required on the Node server for laporan writes,
# media upload, WA queue, and weather cache refresh. Never expose to the browser
# and never set it on the GitHub Pages job.
# SUPABASE_SERVICE_ROLE_KEY=

# Laporan masyarakat (kejadian + penanganan) — server/cron only
# Production refuses submits without PII key + custom salt + service role.
# LAPORAN_PII_KEY=          # 64 hex chars — AES-256-GCM for pelapor PII (generate: node scripts/generate-laporan-pii-key.mjs)
# LAPORAN_PII_SALT=         # custom salt for SHA-256 hashes (NIK/phone lookup); do not use aceh-tangguh-dev
# LAPORAN_CRON_SECRET=      # Bearer for POST /api/cron/laporan-wa
# LAPORAN_CRON_URL=         # optional base URL for scripts/process-laporan-wa.mjs (default http://localhost:3000)
# WHATSAPP_GATEWAY_URL=https://api.fonnte.com/send
# WHATSAPP_GATEWAY_TOKEN=    # Fonnte/Wablas dashboard token (raw Authorization)

# Weather cron (POST /api/weather/refresh) — server-only, never expose
# WEATHER_CRON_SECRET=
# GitHub Actions: set secret WEATHER_CRON_SECRET + variable WEATHER_REFRESH_URL
# (e.g. https://your-domain/api/weather/refresh)
#
# WeatherNext 3 inovasi cron (POST /api/weather/inovasi/refresh) — separate secret.
# Never reuse WEATHER_CRON_SECRET. Without Earth Engine allowlist the GET lane
# stays unconfigured (empty), not invented numbers.
# WEATHER_INOVASI_CRON_SECRET=
# WEATHERNEXT_EE_PROJECT=
# WEATHERNEXT_EE_ACCESS_TOKEN=
# WEATHERNEXT_EE_RAW_PATH=

# Overlay live cron (POST /api/cron/overlay-live) — server-only, never expose
# OVERLAY_CRON_SECRET=
# GitHub Actions: set secret OVERLAY_CRON_SECRET + variable OVERLAY_REFRESH_URL
# (e.g. https://aceh-tangguh.vercel.app/api/cron/overlay-live)

# Daily Brief staff WhatsApp cron (POST /api/cron/daily-brief) — not laporan WA
# DAILY_BRIEF_CRON_SECRET=
# GitHub Actions: set secret DAILY_BRIEF_CRON_SECRET + variable DAILY_BRIEF_URL
# (e.g. https://aceh-tangguh.vercel.app/api/cron/daily-brief)

# Distributed rate limit (required in production when Supabase/laporan is enabled)
# Free tier: https://upstash.com — create a Redis database, copy REST URL + token.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Data routing
# Domain datasets prefer Supabase (anon SELECT) and fall back to
# public/fixtures/*.json when env is missing, a query errors, or the
# table/document is empty:
#   kejadian_bencana, marker_features, anggaran_analisis,
#   anggaran_kegiatan, publikasi_meta, publikasi, publikasi_kegiatan, r3p_summary,
#   irbi_documents, data_documents (optional JSON snapshots)
# Apply supabase/migrations/20260906_cms_domain_tables.sql on new environments.
#
# Geometry stays in fixtures + PMTiles — do not store polygon GeoJSON
# or PMTiles in Postgres:
#   public/fixtures/areas/*.geojson
#   public/fixtures/boundaries-aceh-kab.geojson
#   public/tiles/*.pmtiles
#   GET /api/layers/areas/[key], GET /api/boundaries

# GitHub Pages static preview (optional — fixtures work without these)
# Local: STATIC_EXPORT=1 bun run build   → writes out/
# Actions: set repository variable NEXT_PUBLIC_SUPABASE_URL and
# secret NEXT_PUBLIC_SUPABASE_ANON_KEY if you want the browser to
# have anon credentials. The static preview still reads public/fixtures
# for homepage + map; admin / laporan POST / API routes are omitted.
# STATIC_EXPORT=1
# GITHUB_PAGES=1
# NEXT_PUBLIC_BASE_PATH=/aceh-tangguh

# Panduan / Tanggapi grounded LLM (optional; default off). Keys stay on the
# server — never prefix these with NEXT_PUBLIC_. Empty key, static preview,
# or empty retrieval falls back to the V1 keyword engine.
# When enabled, the default provider is Grok (xAI). Production also needs
# Upstash (UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN) — POST /api/panduan/ask
# uses the same public-post limiter and fails closed without it.
# PANDUAN_LLM_ENABLED=0
# PANDUAN_LLM_PROVIDER=grok
# XAI_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# Default if unset: grok-4.20-0309-non-reasoning (fallback grok-4.6 on model 4xx)
# PANDUAN_LLM_MODEL=

# CARTO Positron/Dark raster. Free key: https://carto.com/basemaps/apikey
# Unset = OSM.org tiles for those styles (Carto without a key is watermarked).
# NEXT_PUBLIC_CARTO_API_KEY=

# Overlay + optional Aceh OSM PMTiles (S3 / Cloudflare R2). No secrets in git.
# Browser reads public URLs only. Sync uses TILES_S3_* + AWS_* (never NEXT_PUBLIC_).
# Overlay default remains /tiles/<file> when TILES_BASE_URL is unset.
# NEXT_PUBLIC_TILES_BASE_URL=https://tiles.example.com/aceh
# NEXT_PUBLIC_ACEH_OSM_PMTILES=/tiles/aceh-osm.pmtiles
# TILES_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# TILES_S3_BUCKET=
# TILES_S3_PREFIX=tiles
# TILES_S3_REGION=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
